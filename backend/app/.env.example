# Backend + local infra bootstrap template (development)
# Copy to backend/app/.env and adjust secrets before real use.

ENVIRONMENT=development

# External OIDC (RS256 only)
JANUS_API_PROFILE=all-test
OIDC_ISSUER=https://idp.example.invalid
OIDC_JWKS_URL=https://idp.example.invalid/.well-known/jwks.json
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.invalid/authorize
OIDC_PUBLIC_CLIENT_ID=janus-spa
OIDC_PUBLIC_SCOPES=["openid","profile","email"]
OIDC_USER_AUDIENCE=janus-user-api
OIDC_SERVICE_ISSUER=https://idp.example.invalid
OIDC_SERVICE_JWKS_URL=https://idp.example.invalid/.well-known/jwks.json
OIDC_SERVICE_AUDIENCE=janus-control-plane
OIDC_SERVICE_TOKEN_URL=https://idp.example.invalid/oauth/token
OIDC_ADMIN_GROUP=janus-administrators
OIDC_SERVICE_PRINCIPALS={"janus-admin-facade":["identity:admin","ops:read","ops:execute","deployment:write","workers:manage","governance:write","autonomy:admin","evaluation:ingest","observability:read","tools:admin"]}
ADMIN_FACADE_CLIENT_ID=janus-admin-facade
ADMIN_FACADE_CLIENT_SECRET=__REQUIRED__

# Postgres (used by compose + backend)
POSTGRES_USER=janus
POSTGRES_PASSWORD=__REQUIRED__
POSTGRES_DB=janus_db

# RabbitMQ (used by compose + management API scripts)
RABBITMQ_USER=janus
RABBITMQ_PASSWORD=__REQUIRED__

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=__REQUIRED__
NEO4J_HEAP_INITIAL=512M
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# Grafana local admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__REQUIRED__

# Cloud-only runtime; local Ollama inference is opt-in.
OLLAMA_ENABLED=false

# Optional cloud providers
# OPENAI_API_KEY=
# OPENAI_MODEL_NAME=gpt-5.6-luna
# OPENAI_MODELS=["gpt-5.6-luna"]
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-3.6-flash
# GEMINI_MODELS=["gemini-3.6-flash"]
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL_NAME=deepseek-v4-flash
# DEEPSEEK_MODELS=["deepseek-v4-flash","deepseek-v4-pro"]
# XAI_API_KEY=
# XAI_MODEL_NAME=grok-4.5
# XAI_MODELS=["grok-4.5"]
# OPENROUTER_API_KEY=
# OPENROUTER_FREE_MODELS_ENABLED=false
# OPENROUTER_REASONING_ENABLED=true
# OPENROUTER_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODELS=["nvidia/nemotron-3-ultra-550b-a55b:free","poolside/laguna-s-2.1:free","cohere/north-mini-code:free","google/gemma-4-31b-it:free","openai/gpt-oss-20b:free"]
# EMBEDDINGS_DEFAULT_PROVIDER=local
# EMBEDDINGS_LOCAL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDINGS_OPENAI_MODEL_NAME=text-embedding-3-small
# EMBEDDINGS_OPENROUTER_MODEL_NAME=qwen/qwen3-embedding-8b
# EMBEDDINGS_OLLAMA_MODEL_NAME=nomic-embed-text
# RAG_RERANK_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Local, Firebase and Supabase token exchange endpoints are intentionally disabled.
