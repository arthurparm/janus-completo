ENVIRONMENT=production
OIDC_ISSUER=https://idp.example.invalid
OIDC_JWKS_URL=https://idp.example.invalid/.well-known/jwks.json
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.invalid/authorize
OIDC_PUBLIC_CLIENT_ID=janus-spa
OIDC_PUBLIC_SCOPES=["openid","profile","email"]
OIDC_USER_AUDIENCE=janus-user-api
OIDC_SERVICE_ISSUER=https://idp.example.invalid
OIDC_SERVICE_JWKS_URL=https://idp.example.invalid/.well-known/jwks.json
OIDC_SERVICE_AUDIENCE=janus-control-plane
OIDC_SERVICE_TOKEN_URL=https://idp.example.invalid/oauth/token
OIDC_ADMIN_GROUP=janus-administrators
OIDC_SERVICE_PRINCIPALS={"janus-admin-facade":["identity:admin","ops:read","ops:execute","deployment:write","workers:manage","governance:write","autonomy:admin","evaluation:ingest","observability:read","tools:admin"]}
ADMIN_FACADE_CLIENT_ID=janus-admin-facade
ADMIN_FACADE_CLIENT_SECRET=__REQUIRED__
CONTROL_PLANE_BASE_URL=http://janus-control-plane:8000
INTERNAL_ACTOR_PRIVATE_KEY_PATH=/run/secrets/janus/internal/private.pem
INTERNAL_ACTOR_PUBLIC_KEY_PATH=/run/secrets/janus/internal/public.pem
AUDIT_LEDGER_HMAC_KEY=__REQUIRED__
SECURITY_ALERT_WEBHOOK_URL=__REQUIRED__
SECURITY_ALERT_WEBHOOK_HMAC_KEY=__REQUIRED__
SECURITY_ALERT_ALLOWED_HOSTS=["security-alerts.example.invalid"]
CORS_ALLOW_ORIGINS=["http://localhost:4300","http://127.0.0.1:4300","http://SEU_DOMINIO_OU_IP:4300"]
FRONTEND_PORT=4300
PUBLIC_API_PORT=8001
CONTROL_PLANE_PORT=8002

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=janus
POSTGRES_PASSWORD=__REQUIRED__
POSTGRES_DB=janus_db

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=janus
RABBITMQ_PASSWORD=__REQUIRED__

NEO4J_URI=bolt://PC2_TAILSCALE_IP:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__REQUIRED__

QDRANT_HOST=PC2_TAILSCALE_IP
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_TLS_CA_CERT=
QDRANT_API_KEY=__REQUIRED__

EMBEDDINGS_DEFAULT_PROVIDER=openai
EMBEDDINGS_FAIL_CLOSED=true
EMBEDDINGS_OPENAI_MODEL_NAME=text-embedding-3-small
EMBEDDINGS_OPENROUTER_MODEL_NAME=qwen/qwen3-embedding-8b
RAG_RERANK_BACKEND=heuristic
LLM_EXECUTOR_MAX_WORKERS=8
TOOL_EXECUTOR_MAX_CONCURRENCY=4
CHAT_STREAM_RUN_LEASE_SECONDS=300
CHAT_STREAM_RUN_RETENTION_HOURS=24
CHAT_STREAM_EVENT_POLL_INTERVAL_MS=200
CHAT_STREAM_SUBSCRIBER_HEARTBEAT_SECONDS=15
ENABLE_GOOGLE_PRODUCTIVITY_WORKER=false

OPENAI_API_KEY=__REQUIRED__
DEEPSEEK_API_KEY=__REQUIRED__
XAI_API_KEY=__REQUIRED__
OPENROUTER_API_KEY=__REQUIRED__
OPENAI_MODEL_NAME=gpt-5.6-luna
OPENAI_MODELS=["gpt-5.6-luna"]
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_MODELS=["deepseek-v4-flash","deepseek-v4-pro"]
XAI_MODEL_NAME=grok-4.5
XAI_MODELS=["grok-4.5"]
OPENROUTER_FREE_MODELS_ENABLED=false
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_MODEL_NAME=poolside/laguna-s-2.1:free
OPENROUTER_MODELS=["poolside/laguna-s-2.1:free","nvidia/nemotron-3-ultra-550b-a55b:free","cohere/north-mini-code:free","google/gemma-4-31b-it:free","openai/gpt-oss-20b:free"]

START_ORCHESTRATOR_WORKERS_ON_STARTUP=true
AUTO_INDEX_ON_STARTUP=false
INIT_MAS_AGENTS_ON_STARTUP=false
AUTONOMY_SELF_STUDY_MAX_RUN_SECONDS=600
AUTONOMY_SELF_STUDY_RUN_DEADLINE_LOCAL=
