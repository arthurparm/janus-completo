NEO4J_USER=neo4j
NEO4J_PASSWORD=__REQUIRED__
NEO4J_HEAP_INITIAL=2G
NEO4J_HEAP_MAX=8G
NEO4J_PAGECACHE=8G

QDRANT_API_KEY=__REQUIRED__
QDRANT_ENABLE_TLS=false
QDRANT_TLS_CERT=
QDRANT_TLS_KEY=
QDRANT_TLS_CA_CERT=

OLLAMA_ORCHESTRATOR_MODEL=gpt-oss:20b
OLLAMA_CODER_MODEL=deepseek-coder:6.7b
OLLAMA_CURATOR_MODEL=ministral-3:14b
OLLAMA_AUTO_PULL_MODELS=true
OLLAMA_KEEP_ALIVE=120m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=128
